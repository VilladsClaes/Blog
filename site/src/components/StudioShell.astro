---
import Base from '../layouts/Base.astro';

interface Props {
  title: string;
  intro: string;
  active: 'video' | 'tekst' | 'billede';
}

const { title, intro, active } = Astro.props;
const tabs = [
  { key: 'video', href: '/studie/video/', label: 'Video' },
  { key: 'tekst', href: '/studie/tekst/', label: 'Tekst' },
  { key: 'billede', href: '/studie/billede/', label: 'Billede' },
];
---

<Base title={title} description={intro} noindex>
  <div class="studio">
    <nav class="studio-nav" aria-label="Vælg opslagstype">
      <a href="/studie/" class:list={['studio-nav-home', { 'is-active': false }]}>Opslagsstudie</a>
      {tabs.map((tab) => (
        <a href={tab.href} class:list={{ 'is-active': tab.key === active }} aria-current={tab.key === active ? 'page' : undefined}>
          {tab.label}
        </a>
      ))}
    </nav>

    <header class="studio-head">
      <p class="meta"><a href="/studie/">← Alle opslagstyper</a></p>
      <h1>{title}</h1>
      <p class="lede">{intro}</p>
    </header>

    <details class="studio-settings">
      <summary>Admin-adgang <span class="studio-summary-note">– nødvendig for at gemme i databasen</span></summary>
      <div class="studio-fields">
        <label>
          Admin-nøgle
          <input id="api-key" type="password" autocomplete="off" spellcheck="false" placeholder="X-Admin-Key" />
        </label>
      </div>
      <div class="studio-row">
        <button type="button" id="api-save">Gem i denne fane</button>
        <button type="button" id="api-test" class="is-secondary">Test forbindelse</button>
        <button type="button" id="api-forget" class="is-link">Glem nøglen</button>
      </div>
      <p id="api-status" class="studio-status" role="status"></p>
      <p class="studio-help">
        Brug den samme admin-nøgle som i <a href="/admin/">skriveværktøjet</a>. Nøglen gemmes kun i denne fane og
        sendes til bloggens eget API – ikke til GitHub eller andre tjenester.
      </p>
    </details>

    <slot />
  </div>
</Base>

<script>
  import '../scripts/studio/settings';
</script>

<style is:global>
  @import '../styles/studio.css';
</style>
