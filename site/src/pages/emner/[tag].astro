---
import Base from '../../layouts/Base.astro';
import { topics } from '../../data/topics';

export async function getStaticPaths() {
  return topics.map((topic) => ({
    params: { tag: topic.slug },
    props: { topic },
  }));
}

const { topic } = Astro.props;
---

<Base title={topic.name}>
  <header class="page-head">
    <p class="back-link"><a href="/emner/">← Alle emner</a></p>
    <p class="eyebrow">Emne</p>
    <h1>{topic.name}</h1>
    <p class="lede"><span data-db-topic-count hidden></span></p>
  </header>

  <div data-db-topic-posts hidden></div>
</Base>
