---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPublishedPosts, tagSlug } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag: tagSlug(tag) },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}
const { tag, posts } = Astro.props;
---

<Base title={tag}>
  <header class="page-head">
    <p class="back-link"><a href="/emner/">← Alle emner</a></p>
    <p class="eyebrow">Emne</p>
    <h1>{tag}</h1>
    <p class="lede">{posts.length} {posts.length === 1 ? 'tekst' : 'tekster'} i dette emne.</p>
  </header>

  <PostList posts={posts} />
</Base>
