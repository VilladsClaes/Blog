---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getPublishedPosts, formatDate, readingMinutes, tagSlug, type Post } from '../lib/posts';
import { siteByKey } from '../data/sites';
import { videoHtml } from '../plugins/directives.mjs';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props { post: Post; newer?: Post; older?: Post }
const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const linkedSites = d.sites.map(siteByKey).filter((s) => s !== undefined);
const features = Object.entries(d.interactive).filter(([, on]) => on).map(([k]) => k).join(' ');
---

<Base title={d.title} description={d.description} slug={post.id}>
  <div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div>

  <article class="post" data-features={features} data-font={d.font}>
    <header class="post-header">
      <div class="meta">
        <time datetime={d.publishDate.toISOString()}>{formatDate(d.publishDate)}</time>
        <span>{readingMinutes(post.body)} min. læsning</span>
        {d.updated && <span>Opdateret {formatDate(d.updated)}</span>}
        {d.archived && <span class="badge">Fra arkivet</span>}
      </div>
      <h1>{d.title}</h1>
      {d.description && <p class="lede">{d.description}</p>}
      {d.tags.length > 0 && (
        <ul class="tags">{d.tags.map((t) => <li><a href={`/emner/${tagSlug(t)}/`}>{t}</a></li>)}</ul>
      )}
      <div class="post-controls sans">
        <button class="reading-toggle" type="button" data-reading-toggle aria-pressed="false" title="Større tekst og mere luft" hidden>
          <span class="reading-toggle-mark" aria-hidden="true">Aa</span>
          <span data-reading-label>Rolig læsning</span>
        </button>
      </div>
    </header>

    {d.cover && (
      <figure class="post-cover">
        <img src={d.cover} alt="" loading="eager" decoding="async" fetchpriority="high" />
      </figure>
    )}

    {d.tldr && (
      <aside class="x-tldr">
        <p class="x-tldr-title">TLDR</p>
        <p>{d.tldr}</p>
      </aside>
    )}

    {d.voice && (
      <figure class="x-voice sans">
        <figcaption>Lyt med min stemme</figcaption>
        <audio id="post-voice" controls preload="metadata" src={d.voice}></audio>
      </figure>
    )}

    {d.video && (
      <div class="prose">
        <Fragment set:html={videoHtml(d.video, d.videoFormat)} />
      </div>
    )}

    <div class="x-tools sans" role="toolbar" aria-label="Værktøjer til indlægget" hidden></div>

    <div class="prose" id="prose">
      <Content />
    </div>

    {(linkedSites.length > 0 || d.links.length > 0) && (
      <aside class="related">
        <h2>Hører sammen med</h2>
        <ul>
          {linkedSites.map((s) => <li><a href={s.url}>{s.name}</a> – {s.description}</li>)}
          {d.links.map((l) => <li><a href={l.url}>{l.title}</a></li>)}
        </ul>
      </aside>
    )}

    <section class="x-annotations sans" hidden>
      <h2>Noter i marginen</h2>
      <ol></ol>
    </section>

    {d.interactive.comments && (
      <section class="x-comments sans" id="besyv">
        <h2>Dit besyv</h2>
        <ol class="x-comment-list"></ol>
        <form class="x-comment-form">
          <label>Navn <input name="name" maxlength="60" autocomplete="name" required /></label>
          <label>Hvad tænker du? <textarea name="body" rows="4" maxlength="4000" required></textarea></label>
          <label class="visually-hidden" aria-hidden="true">Lad være tom <input name="website" tabindex="-1" autocomplete="off" /></label>
          <button type="submit">Send dit besyv</button>
          <p class="x-form-status" role="status"></p>
        </form>
      </section>
    )}

    <footer class="post-end">
      <p>Tak, fordi du læste med.</p>
      <a href="#top">Til toppen ↑</a>
    </footer>

    <nav class="post-nav" aria-label="Flere indlæg">
      {older && (
        <a class="post-nav-item" href={`/${older.id}/`}>
          <span>← Ældre</span>
          <strong>{older.data.title}</strong>
        </a>
      )}
      {newer && (
        <a class="post-nav-item post-nav-next" href={`/${newer.id}/`}>
          <span>Nyere →</span>
          <strong>{newer.data.title}</strong>
        </a>
      )}
    </nav>
  </article>
</Base>

<script>
  import '../scripts/interactive';
</script>

<script>
  const progress = document.querySelector<HTMLElement>('[data-reading-progress]');
  const article = document.querySelector<HTMLElement>('article.post');

  if (progress && article) {
    let frame = 0;

    const update = () => {
      frame = 0;
      const top = article.getBoundingClientRect().top + window.scrollY;
      const distance = article.offsetHeight - window.innerHeight;
      const value = distance > 0 ? (window.scrollY - top) / distance : 0;
      progress.style.transform = `scaleX(${Math.min(1, Math.max(0, value))})`;
    };

    const request = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    update();
    window.addEventListener('scroll', request, { passive: true });
    window.addEventListener('resize', request);
  }

  const readingToggle = document.querySelector<HTMLButtonElement>('[data-reading-toggle]');

  if (readingToggle) {
    const label = readingToggle.querySelector<HTMLElement>('[data-reading-label]');
    let calm = document.documentElement.dataset.reading === 'comfy';

    const applyReadingMode = (on: boolean) => {
      document.documentElement.dataset.reading = on ? 'comfy' : '';
      readingToggle.setAttribute('aria-pressed', String(on));
      if (label) label.textContent = on ? 'Normal visning' : 'Rolig læsning';
    };

    applyReadingMode(calm);
    readingToggle.hidden = false;

    readingToggle.addEventListener('click', () => {
      calm = !calm;
      applyReadingMode(calm);
      try {
        if (calm) localStorage.setItem('reading-mode', '1');
        else localStorage.removeItem('reading-mode');
      } catch {}
    });
  }
</script>

<style is:global>
  @import '../styles/interactive.css';
</style>
